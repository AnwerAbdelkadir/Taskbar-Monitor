App.Settings.WarningColor, v => App.Settings.WarningColor = v);\n        AddColorRow(\"Critical\", () => App.Settings.CriticalColor, v => App.Settings.CriticalColor = v);\n    }\n\n    private void AddColorRow(string title, Func<string> get, Action<string> set)\n    {\n        var row = new Grid { Margin = new Thickness(0, 3, 0, 3) };\n        row.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(150) });\n        row.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });\n        row.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });\n\n        var label = new TextBlock { Text = title, VerticalAlignment = VerticalAlignment.Center };\n\n        var swatch = new Button\n        {\n            Width = 46,\n            Height = 22,\n            Padding = new Thickness(0),\n            Margin = new Thickness(0),\n            MinWidth = 0,\n            BorderThickness = new Thickness(1),\n            BorderBrush = new SolidColorBrush(Color.FromRgb(0xD0, 0xD0, 0xD0))\n        };\n\n        var hex = new TextBlock\n        {\n            VerticalAlignment = VerticalAlignment.Center,\n            Margin = new Thickness(10, 0, 0, 0),\n            FontFamily = new FontFamily(\"Consolas\"),\n            FontSize = 12,\n            Foreground = new SolidColorBrush(Color.FromRgb(0x66, 0x66, 0x66))\n        };\n\n        swatch.Click += (_, _) => PickColor(get, set);\n\n        Grid.SetColumn(swatch, 1);\n        Grid.SetColumn(hex, 2);\n        row.Children.Add(label);\n        row.Children.Add(swatch);\n        row.Children.Add(hex);\n        ColorsPanel.Children.Add(row);\n        _colorEditors.Add(row);\n\n        _colorRefreshers.Add(() =>\n        {\n            var color = Palette.Parse(get(), Colors.Gray);\n            swatch.Background = new SolidColorBrush(color);\n            hex.Text = get();\n        });\n    }\n\n    private void PickColor(Func<string> get, Action<string> set)\n    {\n        using var dialog = new WinForms.ColorDialog { FullOpen = true, AnyColor = true };\n        var current = Palette.Parse(get(), Colors.Gray);\n        dialog.Color = System.Drawing.Color.FromArgb(current.R, current.G, current.B);\n\n        if (dialog.ShowDialog() != WinForms.DialogResult.OK) return;\n\n        set(Palette.ToHex(Color.FromRgb(dialog.Color.R, dialog.Color.G, dialog.Color.B)));\n        if (App.Settings.UseThemePalette)\n        {\n            // Picking a color means the user wants custom colors.\n            App.Settings.UseThemePalette = false;\n            UsePaletteCheck.IsChecked = false;\n        }\n        UpdateColorAvailability();\n        RefreshColors();\n        Apply();\n    }\n\n    private void RefreshColors()\n    {\n        foreach (var refresh in _colorRefreshers) refresh();\n    }\n\n    private void UpdateColorAvailability()\n    {\n        var enabled = UsePaletteCheck.IsChecked != true;\n        foreach (var editor in _colorEditors) editor.IsEnabled = enabled;\n    }\n\n    private void HookEvents()\n    {\n        ThemeCombo.SelectionChanged += (_, _) => Apply();\n        UsePaletteCheck.Checked += (_, _) => { UpdateColorAvailability(); Apply(); };\n        UsePaletteCheck.Unchecked += (_, _) => { UpdateColorAvailability(); Apply(); };\n        FontCombo.SelectionChanged += (_, _) => Apply();\n\n        SizeSlider.ValueChanged += (_, _) => { SizeValue.Text = $\"{SizeSlider.Value:0}\"; Apply(); };\n        SpacingSlider.ValueChanged += (_, _) => { SpacingValue.Text = $\"{SpacingSlider.Value:0}\"; Apply(); };\n        OpacitySlider.ValueChanged += (_, _) => { OpacityValue.Text = $\"{OpacitySlider.Value * 100:0}%\"; Apply(); };\n\n        NetUnitCombo.SelectionChanged += (_, _) => Apply();\n\n        AllMonitorsCheck.Checked += (_, _) => { MonitorCombo.IsEnabled = false; Apply(rebuildOverlays: true); };\n        AllMonitorsCheck.Unchecked += (_, _) => { MonitorCombo.IsEnabled = true; Apply(rebuildOverlays: true); };\n        MonitorCombo.SelectionChanged += (_, _) => Apply(rebuildOverlays: true);\n\n        GapSlider.ValueChanged += (_, _) => { GapValue.Text = $\"{GapSlider.Value:0}\"; Apply(); };\n        RightOffsetSlider.ValueChanged += (_, _) => { RightOffsetValue.Text = $\"{RightOffsetSlider.Value:0}\"; Apply(); };\n        VerticalSlider.ValueChanged += (_, _) => { VerticalValue.Text = $\"{VerticalSlider.Value:0}\"; Apply(); };\n\n        StartWithWindowsCheck.Checked += (_, _) => StartupChanged();\n        StartWithWindowsCheck.Unchecked += (_, _) => StartupChanged();\n        StartElevatedCheck.Checked += (_, _) => StartupChanged();\n        StartElevatedCheck.Unchecked += (_, _) => StartupChanged();\n\n        LabelBox.TextChanged += (_, _) =>\n        {\n            if (_loading || _selectedBlock is null) return;\n            _selectedBlock.Label = string.IsNullOrWhiteSpace(LabelBox.Text) ? null : LabelBox.Text.Trim();\n            Apply();\n        };\n\n        ChkIcon.Checked += (_, _) => DetailChanged();\n        ChkIcon.Unchecked += (_, _) => DetailChanged();\n        ChkLabel.Checked += (_, _) => DetailChanged();\n        ChkLabel.Unchecked += (_, _) => DetailChanged();\n        ChkPercent.Checked += (_, _) => DetailChanged();\n        ChkPercent.Unchecked += (_, _) => DetailChanged();\n        ChkTemp.Checked += (_, _) => DetailChanged();\n        ChkTemp.Unchecked += (_, _) => DetailChanged();\n        ChkPower.Checked += (_, _) => DetailChanged();\n        ChkPower.Unchecked += (_, _) => DetailChanged();\n    }\n\n    private void DetailChanged()\n    {\n        if (_loading || _selectedBlock is null) return;\n        _selectedBlock.ShowIcon = ChkIcon.IsChecked == true;\n        _selectedBlock.ShowLabel = ChkLabel.IsChecked == true;\n        _selectedBlock.ShowPercent = ChkPercent.IsChecked == true;\n        _selectedBlock.ShowTemperature = ChkTemp.IsChecked == true;\n        _selectedBlock.ShowPower = ChkPower.IsChecked == true;\n        Apply();\n    }\n\n    private void LoadFromSettings()\n    {\n        _loading = true;\n\n        var settings = App.Settings;\n        var selectedKind = _selectedBlock?.Kind;\n\n        ThemeCombo.SelectedItem = settings.Theme;\n        UsePaletteCheck.IsChecked = settings.UseThemePalette;\n        FontCombo.SelectedItem = settings.FontFamily;\n        SizeSlider.Value = settings.FontSize;\n        SpacingSlider.Value = settings.Spacing;\n        OpacitySlider.Value = settings.BackgroundOpacity;\n        NetUnitCombo.SelectedItem = settings.NetUnit;\n        AllMonitorsCheck.IsChecked = settings.ShowOnAllMonitors;\n        GapSlider.Value = settings.GapFromTray;\n        RightOffsetSlider.Value = settings.OffsetFromRight;\n        VerticalSlider.Value = settings.OffsetY;\n        StartWithWindowsCheck.IsChecked = settings.StartWithWindows;\n        StartElevatedCheck.IsChecked = settings.StartElevated;\n\n        SizeValue.Text = $\"{settings.FontSize:0}\";\n        SpacingValue.Text = $\"{settings.Spacing:0}\";\n        OpacityValue.Text = $\"{settings.BackgroundOpacity * 100:0}%\";\n        GapValue.Text = $\"{settings.GapFromTray:0}\";\n        RightOffsetValue.Text = $\"{settings.OffsetFromRight:0}\";\n        VerticalValue.Text = $\"{settings.OffsetY:0}\";\n\n        PopulateMonitors(settings);\n        RefreshColors();\n        UpdateColorAvailability();\n\n        _selectedBlock = selectedKind is null\n            ? null\n            : settings.Blocks.FirstOrDefault(b => b.Kind == selectedKind);\n\n        RebuildBlocks();\n        ShowDetails(_selectedBlock);\n\n        _loading = false;\n    }\n\n    private void PopulateMonitors(AppSettings settings)\n    {\n        var screens = WinForms.Screen.AllScreens;\n        var entries = screens\n            .Select(screen => new MonitorEntry(screen.DeviceName,\n                $\"{screen.DeviceName}  —  {screen.Bounds.Width}×{screen.Bounds.Height}{(screen.Primary ? \"  (primary)\" : \"\")}\"))\n            .ToList();\n\n        MonitorCombo.ItemsSource = entries;\n        var primary = screens.FirstOrDefault(s => s.Primary)?.DeviceName;\n        MonitorCombo.SelectedItem =\n            entries.FirstOrDefault(e => string.Equals(e.Device, settings.MonitorDevice, StringComparison.OrdinalIgnoreCase))\n            ?? entries.FirstOrDefault(e => e.Device == primary)\n            ?? entries.FirstOrDefault();\n        MonitorCombo.IsEnabled = !settings.ShowOnAllMonitors;\n    }\n\n    private void RebuildBlocks()\n    {\n        BlocksPanel.Children.Clear();\n\n        foreach (var block in App.Settings.Blocks.OrderBy(b => b.Row).ThenBy(b => b.Order))\n        {\n            var grid = new Grid { Height = 36 };\n            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(34) });\n            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });\n            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });\n            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(32) });\n            grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(32) });\n\n            var check = new CheckBox\n            {\n                IsChecked = block.Enabled,\n                VerticalAlignment = VerticalAlignment.Center,\n                Margin = new Thickness(10, 0, 0, 0)\n            };\n            check.Checked += (_, _) => { block.Enabled = true; Apply(); };\n            check.Unchecked += (_, _) => { block.Enabled = false; Apply(); };\n\n            var name = new TextBlock\n            {\n                Text = block.Kind.Title(),\n                VerticalAlignment = VerticalAlignment.Center,\n                Margin = new Thickness(4, 0, 0, 0),\n                FontSize = 12.5\n            };\n\n            var rowCombo = new ComboBox\n            {\n                ItemsSource = new[] { \"Row 1\", \"Row 2\" },\n                SelectedIndex = block.Row - 1,\n                Width = 82,\n          