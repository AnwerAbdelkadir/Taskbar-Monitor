       value = Parse(settings.ValueColor, light ? Colors.Black : Colors.White);\n            temp = Parse(settings.TempColor, Colors.Gray);\n            warning = Parse(settings.WarningColor, Colors.Orange);\n            critical = Parse(settings.CriticalColor, Colors.Red);\n        }\n\n        var alpha = (byte)Math.Round(Math.Clamp(settings.BackgroundOpacity, 0.1, 1) * 255);\n        background = Color.FromArgb(alpha, background.R, background.G, background.B);\n\n        return new Palette\n        {\n            Light = light,\n            Background = Freeze(new SolidColorBrush(background)),\n            Label = Freeze(new SolidColorBrush(label)),\n            Value = Freeze(new SolidColorBrush(value)),\n            Temp = Freeze(new SolidColorBrush(temp)),\n            Warning = Freeze(new SolidColorBrush(warning)),\n            Critical = Freeze(new SolidColorBrush(critical))\n        };\n    }\n\n    public static bool SystemUsesLightTheme()\n    {\n        try\n        {\n            using var key = Registry.CurrentUser.OpenSubKey(\n                @\"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize\");\n            return key?.GetValue(\"SystemUsesLightTheme\") is not int value || value != 0;\n        }\n        catch\n        {\n            return true;\n        }\n    }\n\n    public static Color Parse(string? hex, Color fallback)\n    {\n        try\n        {\n            return string.IsNullOrWhiteSpace(hex)\n                ? fallback\n                : (Color)ColorConverter.ConvertFromString(hex);\n        }\n        catch\n        {\n            return fallback;\n        }\n    }\n\n    public static string ToHex(Color color) => $\"#{color.R:X2}{color.G:X2}{color.B:X2}\";\n\n    private static SolidColorBrush Freeze(SolidColorBrush brush)\n    {\n        brush.Freeze();\n        return brush;\n    }\n}\n",
