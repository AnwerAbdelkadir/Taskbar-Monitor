              "content": "using System.Text.Json;\nusing System.Text.Json.Serialization;\n\nnamespace TaskbarMonitor;\n\npublic enum MetricKind\n{\n    Cpu,\n    Gpu,\n    Ram,\n    Vram,\n    NetUp,\n    NetDown,\n    DiskActivity,\n    DiskSpace,\n    Battery\n}\n\npublic sealed class BlockSettings\n{\n    public MetricKind Kind { get; set; }\n    public bool Enabled { get; set; } = true;\n    public int Row { get; set; } = 1;\n    public int Order { get; set; }\n    public string? Label { get; set; }\n    public bool ShowLabel { get; set; } = true;\n    public bool ShowIcon { get; set; } = true;\n    public bool ShowPercent { get; set; } = true;\n    public bool ShowTemperature { get; set; } = true;\n    public bool ShowPower { get; set; }\n\n    public BlockSettings Clone() => (BlockSettings)MemberwiseClone();\n\n    public string EffectiveLabel() =>\n        string.IsNullOrWhiteSpace(Label) ? Kind.DefaultLabel() : Label!;\n}\n\npublic sealed class AppSettings\n{\n    public int Version { get; set; } = 1;\n    public int RefreshMs { get; set; } = 1000;\n\n    public string Theme { get; set; } = \"Auto\";          // Auto | Light | Dark\n    public bool UseThemePalette { get; set; } = true;\n    public string BackgroundColor { get; set; } = \"#F2F2F2\";\n    public double BackgroundOpacity { get; set; } = 0.94;\n    public string LabelColor { get; set; } = \"#1F6FB5\";\n    public string ValueColor { get; set; } = \"#1A1A1A\";\n    public string TempColor { get; set; } = \"#666666\";\n    public string WarningColor { get; set; } = \"#E07B00\";\n    public string CriticalColor { get; set; } = \"#D32F2F\";\n\n    public string FontFamily { get; set; } = \"Segoe UI\";\n    public double FontSize { get; set; } = 12;\n    public double Spacing { get; set; } = 12;\n\n    public double OffsetFromRight { get; set; } = 0;      // 0 = auto (left of tray)\n    public double GapFromTray { get; set; } = 8;\n    public double OffsetY { get; set; } = 0;\n    public bool ShowOnAllMonitors { get; set; }\n    public string MonitorDevice { get; set; } = \"\";\n\n    public bool StartWithWindows { get; set; }\n    public bool StartElevated { get; set; }\n    public string NetUnit { get; set; } = \"Mbps\";         // Mbps | MB/s\n\n    public List<BlockSettings> Blocks { get; set; } = DefaultBlocks();\n\n    public static List<BlockSettings> DefaultBlocks() => new()\n    {\n        new() { Kind = MetricKind.NetUp,   Row = 1, Order = 0, ShowLabel = false },\n        new() { Kind = MetricKind.Cpu,     Row = 1, Order = 1 },\n        new() { Kind = MetricKind.Ram,     Row = 1, Order = 2, ShowPercent = false, ShowTemperature = false },\n        new() { Kind = MetricKind.NetDown, Row = 2, Order = 0, ShowLabel = false },\n        new() { Kind = MetricKind.Gpu,     Row = 2, Order = 1 },\n        new() { Kind = MetricKind.Vram,    Row = 2, Order = 2, ShowPercent = false, ShowTemperature = false },\n        new() { Kind = MetricKind.DiskActivity, Row = 2, Order = 3, Enabled = false },\n        new() { Kind = MetricKind.DiskSpace,    Row = 2, Order = 4, Enabled = false, ShowPercent = false, ShowTemperature = false },\n        new() { Kind = MetricKind.Battery,      Row = 2, Order = 5, Enabled = false, ShowTemperature = false }\n    };\n\n    public AppSettings Clone()\n    {\n        var copy = (AppSettings)MemberwiseClone();\n        copy.Blocks = Blocks.Select(b => b.Clone()).ToList();\n        return copy;\n    }\n\n    public void Normalize()\n    {\n        Blocks ??= DefaultBlocks();\n        foreach (var kind in Enum.GetValues<MetricKind>())\n            if (Blocks.All(b => b.Kind != kind))\n                Blocks.Add(new BlockSettings { Kind = kind, Enabled = false });\n\n        Blocks.RemoveAll(b => !Enum.IsDefined(b.Kind));\n        int row1 = 0, row2 = 0;\n        foreach (var b in Blocks.Where(b => b.Row == 1).OrderBy(b => b.Order).ToList()) b.Order = row1++;\n        foreach (var b in Blocks.Where(b => b.Row != 1).OrderBy(b => b.Order).ToList()) b.Row = 2;\n        foreach (var b in Blocks.Where(b => b.Row == 2).OrderBy(b => b.Order).ToList()) b.Order = row2++;\n\n        if (!Blocks.Any(b => b.Enabled)) Blocks[0].Enabled = true;\n\n        RefreshMs = Math.Clamp(RefreshMs, 250, 10000);\n        FontSize = Math.Clamp(FontSize, 8, 24);\n        Spacing = Math.Clamp(Spacing, 0, 40);\n        GapFromTray = Math.Clamp(GapFromTray, 0, 400);\n        OffsetFromRight = Math.Clamp(OffsetFromRight, 0, 2000);\n        OffsetY = Math.Clamp(OffsetY, -40, 60);\n        BackgroundOpacity = Math.Clamp(BackgroundOpacity, 0.1, 1);\n        if (string.IsNullOrWhiteSpace(FontFamily)) FontFamily = \"Segoe UI\";\n        if (NetUnit != \"MB/s\") NetUnit = \"Mbps\";\n        if (Theme is not (\"Auto\" or \"Light\" or \"Dark\")) Theme = \"Auto\";\n    }\n}\n\npublic static class MetricKindInfo\n{\n    public static string Title(this MetricKind k) => k switch\n    {\n        MetricKind.Cpu => \"CPU usage & temperature\",\n        MetricKind.Gpu => \"GPU usage, temperature & power\",\n        MetricKind.Ram => \"RAM used / total\",\n        MetricKind.Vram => \"VRAM used / total\",\n        MetricKind.NetUp => \"Network upload speed\",\n        MetricKind.NetDown => \"Network download speed\",\n        MetricKind.DiskActivity => \"Disk activity\",\n        MetricKind.DiskSpace => \"Disk space used / total\",\n        MetricKind.Battery => \"Battery level\",\n        _ => k.ToString()\n    };\n\n    public static string DefaultLabel(this MetricKind k) => k switch\n    {\n        MetricKind.Cpu => \"CPU\",\n        MetricKind.Gpu => \"GPU\",\n        MetricKind.Ram => \"RAM\",\n        MetricKind.Vram => \"VRAM\",\n        MetricKind.DiskActivity => \"DISK\",\n        MetricKind.DiskSpace => \"DISK\",\n        MetricKind.Battery => \"BAT\",\n        _ => \"\"\n    };\n\n    public static bool SupportsPercent(this MetricKind k) =>\n        k is MetricKind.Cpu or MetricKind.Gpu or MetricKind.Ram or MetricKind.Vram or MetricKind.DiskActivity or MetricKind.Battery;\n\n    public static bool SupportsTemperature(this MetricKind k) =>\n        k is MetricKind.Cpu or MetricKind.Gpu or MetricKind.Vram;\n\n    public static bool SupportsPower(this MetricKind k) =>\n        k is MetricKind.Cpu or MetricKind.Gpu;\n}\n\npublic static class SettingsStore\n{\n    private static readonly JsonSerializerOptions JsonOptions = new()\n    {\n        WriteIndented = true,\n        PropertyNameCaseInsensitive = true,\n        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,\n        Converters = { new JsonStringEnumConverter() }\n    };\n\n    public static string Folder { get; } = Path.Combine(\n        Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData), \"TaskbarMonitor\");\n\n    private static string FilePath => Path.Combine(Folder, \"settings.json\");\n\n    public static AppSettings Load()\n    {\n        try\n        {\n            if (File.Exists(FilePath))\n            {\n                var settings = JsonSerializer.Deserialize<AppSettings>(File.ReadAllText(FilePath), JsonOptions);\n                if (settings != null)\n                {\n                    settings.Normalize();\n                    return settings;\n                }\n            }\n        }\n        catch (Exception ex)\n        {\n            Log.Error(\"settings load\", ex);\n        }\n\n        var defaults = new AppSettings();\n        defaults.Normalize();\n        return defaults;\n    }\n\n    public static void Save(AppSettings settings)\n    {\n        try\n        {\n            Directory.CreateDirectory(Folder);\n            File.WriteAllText(FilePath, JsonSerializer.Serialize(settings, JsonOptions));\n        }\n        catch (Exception ex)\n        {\n            Log.Error(\"settings save\", ex);\n        }\n    }\n}\n\npublic static class Log\n{\n    private static readonly object Gate = new();\n    private static string FilePath => Path.Combine(SettingsStore.Folder, \"log.txt\");\n\n    public static void Info(string message) => Write(\"INFO\", message, null);\n\n    public static void Error(string where, Exception ex) => Write(\"ERROR\", where, ex);\n\n    private static void Write(string level, string message, Exception? ex)\n    {\n        // shortcut: one log file, no rotation; fine for a personal tray tool.\n        try\n        {\n            lock (Gate)\n            {\n                Directory.CreateDirectory(SettingsStore.Folder);\n                var line = $\"{DateTime.Now:yyyy-MM-dd HH:mm:ss} [{level}] {message}{(ex is null ? \"\" : \" :: \" + ex)}\";\n                File.AppendAllText(FilePath, line + Environment.NewLine);\n            }\n        }\n        catch\n        {\n            // logging must never take the app down\n        }\n    }\n}\n",
