13 });\n    text.Children.Add(new TextBlock { Text = block.Kind.Description(), FontSize = 11.5, Foreground = muted, Margin = new Thickness(0,2,0,0) });\n\n    var toggle = new CheckBox { Style = (Style)FindResource(\"Switch\"), IsChecked = block.Enabled, VerticalAlignment = Center, ToolTip = \"Show on the taskbar\" };\n    toggle.Checked += (_, _) => { block.Enabled = true; Apply(); RebuildBlocks(); };\n    toggle.Unchecked += (_, _) => { block.Enabled = false; Apply(); RebuildBlocks(); };\n\n    var chevron = new Path { Data = Geometry.Parse(expanded ? \"M2,7 L6,3 L10,7\" : \"M2,4 L6,8 L10,4\"), Stroke = mutedBrush, StrokeThickness = 1.5, Width = 12, Height = 12, Stretch = Stretch.Uniform, VerticalAlignment = Center, Margin = new Thickness(12,0,2,0) };\n\n    Grid.SetColumn(icon, 0); ... text 1, toggle 2, chevron 3.\n    header.Children.Add...\n\n    header.MouseLeftButtonUp += (_, _) =>\n    {\n        _selectedBlock = expanded ? null : block;\n        RebuildBlocks();\n    };\n\n    content.Children.Add(header);\n\n    if (expanded)\n    {\n        content.Children.Add(new Border { Height = 1, Background = LineSoft, Margin = new Thickness(16,0,16,0) });\n        content.Children.Add(BuildOptions(block));\n    }\n\n    return new Border\n    {\n        Child = content,\n        Background = expanded ? (Brush)FindResource(\"RowHighlight\") : Brushes.Transparent,\n        CornerRadius = new CornerRadius(8),\n        Margin = new Thickness(4, 2, 4, 2)\n    };\n}\n```\nHmm: expanded highlight + margin 4 inside the card; the divider spans 16. Fine.\n\nNote: the row Border has Margin 4,2, meaning rows are slightly inset. The header height 58. The card's first row has 2px top margin.\n\n`header.MouseLeftButtonUp` also fires when clicking the icon/text. Switch clicks are handled. Chevron clicks bubble to the header (chevron is not a control) → toggles. Good.\n\nThe `expanded` variable is captured at build time; after toggle, RebuildBlocks creates new rows with the new state.\n\nBuildOptions:\n```csharp\nprivate FrameworkElement BuildOptions(BlockSettings block)\n{\n    var panel = new StackPanel { Margin = new Thickness(16, 12, 16, 14) };\n\n    // label\n    var labelGrid = new Grid { Margin = new Thickness(0, 0, 0, 8) };\n    labelGrid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(90) });\n    labelGrid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });\n    var labelTitle = new TextBlock { Text = \"Label\", VerticalAlignment = VerticalAlignment.Center };\n    var labelBox = new TextBox { Text = block.Label ?? \"\", MaxWidth = 280, HorizontalAlignment = HorizontalAlignment.Left };\n    labelBox.TextChanged += (_, _) =>\n    {\n        if (_loading) return;\n        block.Label = string.IsNullOrWhiteSpace(labelBox.Text) ? null : labelBox.Text.Trim();\n        Apply();\n    };\n    Grid.SetColumn(labelBox, 1);\n    labelGrid.Children.Add(labelTitle);\n    labelGrid.Children.Add(labelBox);\n    panel.Children.Add(labelGrid);\n\n    // toggles\n    var wrap = new WrapPanel();\n    wrap.Children.Add(ToggleCell(\"Icon\", block.ShowIcon, v => { block.ShowIcon = v; Apply(); }));\n    wrap.Children.Add(ToggleCell(\"Name\", block.ShowLabel, v => { block.ShowLabel = v; Apply(); }));\n    if (block.Kind.SupportsPercent())\n        wrap.Children.Add(ToggleCell(\"Percentage\", block.ShowPercent, v => { block.ShowPercent = v; Apply(); }));\n    if (block.Kind.SupportsTemperature())\n        wrap.Children.Add(ToggleCell(\"Temperature\", block.ShowTemperature, v => { block.ShowTemperature = v; Apply(); }));\n    if (block.Kind.SupportsPower())\n        wrap.Children.Add(ToggleCell(\"Power (W)\", block.ShowPower, v => { block.ShowPower = v; Apply(); }));\n    panel.Children.Add(wrap);\n\n    // line + order\n    var footer = new StackPanel { Orientation = Orientation.Horizontal, Margin = new Thickness(0, 10, 0, 0) };\n    footer.Children.Add(new TextBlock { Text = \"Line\", VerticalAlignment = VerticalAlignment.Center, Margin = new Thickness(0,0,10,0), Foreground = muted });\n    footer.Children.Add(SegmentButton(\"Top\", block.Row == 1, () => SetBlockRow(block, 1)));\n    footer.Children.Add(SegmentButton(\"Bottom\", block.Row == 2, () => SetBlockRow(block, 2)));\n    footer.Children.Add(new Border { Width = 18 });\n    footer.Children.Add(ChipButton(\"↑\", \"Move up\", () => MoveBlock(block, -1)));\n    footer.Children.Add(ChipButton(\"↓\", \"Move down\", () => MoveBlock(block, 1)));\n    panel.Children.Add(footer);\n\n    return panel;\n}\n```\nToggleCell:\n```csharp\nprivate FrameworkElement ToggleCell(string text, bool value, Action<bool> changed)\n{\n    var box = new CheckBox { Style = (Style)FindResource(\"Switch\"), IsChecked = value, VerticalAlignment = VerticalAlignment.Center };\n    box.Checked += (_, _) => changed(true);\n    box.Unchecked += (_, _) => changed(false);\n\n    var grid = new Grid { Width = 196, Margin = new Thickness(0, 3, 12, 3) };\n    grid.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });\n    grid.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });\n    var label = new TextBlock { Text = text, VerticalAlignment = VerticalAlignment.Center, FontSize = 12.5 };\n    Grid.SetColumn(box, 1);\n    grid.Children.Add(label);\n    grid.Children.Add(box);\n    return grid;\n}\n```\nSegmentButton and ChipButton:\n```csharp\nprivate FrameworkElement SegmentButton(string text, bool selected, Action onClick)\n{\n    var border = new Border\n    {\n        CornerRadius = new CornerRadius(6),\n        Padding = new Thickness(12, 5, 12, 5),\n        Margin = new Thickness(0, 0, 4, 0),\n        Background = (Brush)FindResource(selected ? \"Accent\" : \"Chip\"),\n        Cursor = Cursors.Hand,\n        Child = new TextBlock\n        {\n            Text = text,\n            FontSize = 12,\n            Foreground = selected ? Brushes.White : (Brush)FindResource(\"Ink\")\n        }\n    };\n    border.MouseLeftButtonUp += (_, _) => onClick();\n    return border;\n}\n\nprivate FrameworkElement ChipButton(string glyph, string tip, Action onClick)\n{\n    var border = new Border\n    {\n        Width = 28, Height = 26,\n        CornerRadius = new CornerRadius(6),\n        Background = (Brush)FindResource(\"Chip\"),\n        Margin = new Thickness(0, 0, 4, 0),\n        Cursor = Cursors.Hand,\n        ToolTip = tip,\n        Child = new TextBlock { Text = glyph, FontSize = 12.5, HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Center }\n    };\n    border.MouseLeftButtonUp += (_, _) => onClick();\n    return border;\n}\n```\n\nSetBlockRow:\n```csharp\nprivate void SetBlockRow(BlockSettings block, int row)\n{\n    if (block.Row == row) return;\n    block.Row = row;\n    block.Order = App.Settings.Blocks.Count(b => b.Row == row);\n    Apply();\n    RebuildBlocks();\n}\n```\nMoveBlock as before.\n\n`Apply()` calls RefreshColors + UpdateColorAvailability, fine.\n\n`LoadFromSettings`:\n```csharp\n_selectedBlock = _selectedBlock is null ? null : settings.Blocks.FirstOrDefault(b => b.Kind == _selectedBlock.Kind);\nRebuildBlocks();\n```\n\nNav handler.\n\nUpdateStatus unchanged.\n\n`PickColor` uses `UsePaletteCheck.IsChecked = false` → triggers Apply via Unchecked. Fine.\n\nBuildColorRows unchanged except margins.\n\nWindow icon/dark title bar.\n\n`ShowDetails` removed.\n\nAlso `SizeValue` etc updated in ValueChanged handlers (same).\n\n`FooterStatus` removed from code? It doesn't exist in the new XAML; the old code didn't reference it. Fine.\n\n`DetailsTitle` etc. removed.\n\nEnsure `using System.Windows.Input;` for Cursors (I use System.Windows.Input.Cursors fully qualified? Add the using). Cursors is in System.Windows.Input.\n\n`Path` alias.\n\nPotential ambiguity: `Grid`, `Border`, `TextBlock`, `CheckBox`, `ComboBox`, `StackPanel`, `WrapPanel`, `Slider` unambiguous (no WinForms globals now).\n\n`Geometr