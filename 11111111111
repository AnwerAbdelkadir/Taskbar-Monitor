              "content": "using System.Diagnostics;\nusing System.Windows;\nusing System.Windows.Controls;\nusing System.Windows.Input;\nusing System.Windows.Interop;\nusing System.Windows.Media;\nusing System.Windows.Threading;\nusing Path = System.Windows.Shapes.Path;\nusing WinForms = System.Windows.Forms;\n\nnamespace TaskbarMonitor;\n\npublic partial class SettingsWindow : Window\n{\n    private readonly MeterView _preview = new();\n    private readonly List<Action> _colorRefreshers = new();\n    private readonly List<FrameworkElement> _colorEditors = new();\n    private readonly DispatcherTimer _statusTimer;\n    private BlockSettings? _selectedBlock;\n    private bool _loading;\n\n    private sealed record MonitorEntry(string Device, string Display);\n\n    public SettingsWindow()\n    {\n        InitializeComponent();\n\n        PreviewHost.Content = _preview;\n        BuildChoices();\n        BuildColorRows();\n        LoadFromSettings();\n        HookEvents();\n\n        UpdatePreview(true);\n        UpdateStatus();\n\n        _statusTimer = new DispatcherTimer { Interval = TimeSpan.FromSeconds(2) };\n        _statusTimer.Tick += (_, _) => UpdateStatus();\n        _statusTimer.Start();\n        Closed += (_, _) => _statusTimer.Stop();\n    }\n\n    protected override void OnSourceInitialized(EventArgs e)\n    {\n        base.OnSourceInitialized(e);\n\n        // Dark title bar to sit next to the dark sidebar.\n        var handle = new WindowInteropHelper(this).Handle;\n        var dark = 1;\n        if (Native.DwmSetWindowAttribute(handle, 20, ref dark, sizeof(int)) != 0)\n            Native.DwmSetWindowAttribute(handle, 19, ref dark, sizeof(int));\n    }\n\n    private void Nav_Checked(object sender, RoutedEventArgs e)\n    {\n        if (BlocksPage is null) return;\n\n        var tag = (sender as FrameworkElement)?.Tag as string ?? \"Blocks\";\n\n        BlocksPage.Visibility = tag == \"Blocks\" ? Visibility.Visible : Visibility.Collapsed;\n        AppearancePage.Visibility = tag == \"Appearance\" ? Visibility.Visible : Visibility.Collapsed;\n        PositionPage.Visibility = tag == \"Position\" ? Visibility.Visible : Visibility.Collapsed;\n        StartupPage.Visibility = tag == \"Startup\" ? Visibility.Visible : Visibility.Collapsed;\n\n        PageTitle.Text = tag;\n        PageSubtitle.Text = tag switch\n        {\n            \"Appearance\" => \"Theme, typography and colors of the readings.\",\n            \"Position\" => \"Where the readings sit on the taskbar.\",\n            \"Startup\" => \"Startup, permissions and sensor status.\",\n            _ => \"Choose what the taskbar shows and how it is arranged.\"\n        };\n    }\n\n    private void BuildChoices()\n    {\n        ThemeCombo.ItemsSource = new[] { \"Auto\", \"Light\", \"Dark\" };\n        FontCombo.ItemsSource = new[] { \"Segoe UI\", \"Segoe UI Variable Text\", \"Tahoma\", \"Consolas\", \"Bahnschrift\", \"Arial\" };\n        NetUnitCombo.ItemsSource = new[] { \"Mbps\", \"MB/s\" };\n    }\n\n    private void BuildColorRows()\n    {\n        AddColorRow(\"Panel background\", () => App.Settings.BackgroundColor, v => App.Settings.BackgroundColor = v);\n        AddColorRow(\"Label\", () => App.Settings.LabelColor, v => App.Settings.LabelColor = v);\n        AddColorRow(\"Value\", () => App.Settings.ValueColor, v => App.Settings.ValueColor = v);\n        AddColorRow(\"Temperature\", () => App.Settings.TempColor, v => App.Settings.TempColor = v);\n        AddColorRow(\"Warning\", () => App.Settings.WarningColor, v => App.Settings.WarningColor = v);\n        AddColorRow(\"Critical\", () => App.Settings.CriticalColor, v => App.Settings.CriticalColor = v);\n    }\n\n    private void AddColorRow(string title, Func<string> get, Action<string> set)\n    {\n        var row = new Grid { Margin = new Thickness(16, 3, 16, 3) };\n        row.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(150) });\n        row.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });\n        row.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });\n\n        var label = new TextBlock { Text = title, VerticalAlignment = VerticalAlignment.Center };\n\n        var swatch = new Border\n        {\n            Width = 46,\n            Height = 22,\n            CornerRadius = new CornerRadius(3),\n            BorderThickness = new Thickness(1),\n            BorderBrush = new SolidColorBrush(Color.FromRgb(0xD0, 0xD0, 0xD0)),\n            Cursor = Cursors.Hand,\n            ToolTip = \"Pick a color\"\n        };\n\n        var hex = new TextBlock\n        {\n            VerticalAlignment = VerticalAlignment.Center,\n            Margin = new Thickness(10, 0, 0, 0),\n            FontFamily = new FontFamily(\"Consolas\"),\n            FontSize = 12,\n            Foreground = (Brush)FindResource(\"Muted\")\n        };\n\n        swatch.MouseLeftButtonUp += (_, _) => PickColor(get, set);\n\n        Grid.SetColumn(swatch, 1);\n        Grid.SetColumn(hex, 2);\n        row.Children.Add(label);\n        row.Children.Add(swatch);\n        row.Children.Add(hex);\n        ColorsPanel.Children.Add(row);\n        _colorEditors.Add(row);\n\n        _colorRefreshers.Add(() =>\n        {\n            var color = Palette.Parse(get(), Colors.Gray);\n            swatch.Background = new SolidColorBrush(color);\n            hex.Text = get();\n        });\n    }\n\n    private void PickColor(Func<string> get, Action<string> set)\n    {\n        using var dialog = new WinForms.ColorDialog { FullOpen = true, AnyColor = true };\n        var current = Palette.Parse(get(), Colors.Gray);\n        dialog.Color = System.Drawing.Color.FromArgb(current.R, current.G, current.B);\n\n        if (dialog.ShowDialog() != WinForms.DialogResult.OK) return;\n\n        set(Palette.ToHex(Color.FromRgb(dialog.Color.R, dialog.Color.G, dialog.Color.B)));\n        if (App.Settings.UseThemePalette)\n        {\n            // Picking a color means the user wants custom colors.\n            App.Settings.UseThemePalette = false;\n            UsePaletteCheck.IsChecked = false;\n        }\n        UpdateColorAvailability();\n        RefreshColors();\n        Apply();\n    }\n\n    private void RefreshColors()\n    {\n        foreach (var refresh in _colorRefreshers) refresh();\n    }\n\n    private void UpdateColorAvailability()\n    {\n        var enabled = UsePaletteCheck.IsChecked != true;\n        foreach (var editor in _colorEditors) editor.IsEnabled = enabled;\n    }\n\n    private void HookEvents()\n    {\n        ThemeCombo.SelectionChanged += (_, _) => Apply();\n        UsePaletteCheck.Checked += (_, _) => { UpdateColorAvailability(); Apply(); };\n        UsePaletteCheck.Unchecked += (_, _) => { UpdateColorAvailability(); Apply(); };\n        FontCombo.SelectionChanged += (_, _) => Apply();\n\n        SizeSlider.ValueChanged += (_, _) => { SizeValue.Text = $\"{SizeSlider.Value:0}\"; Apply(); };\n        SpacingSlider.ValueChanged += (_, _) => { SpacingValue.Text = $\"{SpacingSlider.Value:0}\"; Apply(); };\n        OpacitySlider.ValueChanged += (_, _) => { OpacityValue.Text = $\"{OpacitySlider.Value * 100:0}%\"; Apply(); };\n\n        NetUnitCombo.SelectionChanged += (_, _) => Apply();\n\n        AllMonitorsCheck.Checked += (_, _) => { MonitorCombo.IsEnabled = false; Apply(rebuildOverlays: true); };\n        AllMonitorsCheck.Unchecked += (_, _) => { MonitorCombo.IsEnabled = true; Apply(rebuildOverlays: true); };\n        MonitorCombo.SelectionChanged += (_, _) => Apply(rebuildOverlays: true);\n\n        GapSlider.ValueChanged += (_, _) => { GapValue.Text = $\"{GapSlider.Value:0}\"; Apply(); };\n        RightOffsetSlider.ValueChanged += (_, _) => { RightOffsetValue.Text = $\"{RightOffsetSlider.Value:0}\"; Apply(); };\n        VerticalSlider.ValueChanged += (_, _) => { VerticalValue.Text = $\"{VerticalSlider.Value:0}\"; Apply(); };\n\n        StartWithWindowsCheck.Checked += (_, _) => StartupChanged();