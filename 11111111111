sWindow.xaml + .cs\n12. README.md\n\nThat's reasonable. Write carefully. Start now; retry the two aborted files plus the rest.\n\nLet me write compact but complete code.\n\nI'll write `Models.cs`:\n\n```csharp\nusing System.Text.Json;\nusing System.Text.Json.Serialization;\n\nnamespace TaskbarMonitor;\n\npublic enum MetricKind { Cpu, Gpu, Ram, Vram, NetUp, NetDown, DiskActivity, DiskSpace, Battery }\n\npublic sealed class BlockSettings\n{\n    public MetricKind Kind { get; set; }\n    public bool Enabled { get; set; } = true;\n    public int Row { get; set; } = 1;\n    public int Order { get; set; }\n    public string? Label { get; set; }\n    public bool ShowLabel { get; set; } = true;\n    public bool ShowIcon { get; set; } = true;\n    public bool ShowPercent { get; set; } = true;\n    public bool ShowTemperature { get; set; } = true;\n    public bool ShowPower { get; set; }\n\n    public BlockSettings Clone() => (BlockSettings)MemberwiseClone();\n}\n\npublic sealed class AppSettings\n{\n    public int Version { get; set; } = 1;\n    public int RefreshMs { get; set; } = 1000;\n    public string Theme { get; set; } = \"Auto\";\n    public bool UseThemePalette { get; set; } = true;\n    public string BackgroundColor { get; set; } = \"#F2F2F2\";\n    public string LabelColor { get; set; } = \"#1F6FB5\";\n    public string ValueColor { get; set; } = \"#1A1A1A\";\n    public string TempColor { get; set; } = \"#666666\";\n    public string WarningColor { get; set; } = \"#E07B00\";\n    public string CriticalColor { get; set; } = \"#D32F2F\";\n    public double BackgroundOpacity { get; set; } = 0.94;\n    public string FontFamily { get; set; } = \"Segoe UI\";\n    public double FontSize { get; set; } = 12;\n    public double Spacing { get; set; } = 12;\n    public double OffsetFromRight { get; set; } = 0;\n    public double GapFromTray { get; set; } = 8;\n    public double OffsetY { get; set; } = 0;\n    public bool ShowOnAllMonitors { get; set; }\n    public string MonitorDevice { get; set; } = \"\";\n    public bool StartWithWindows { get; set; }\n    public bool StartElevated { get; set; }\n    public string NetUnit { get; set; } = \"Mbps\";\n    public List<BlockSettings> Blocks { get; set; } = DefaultBlocks();\n\n    public static List<BlockSettings> DefaultBlocks() => new()\n    {\n        new() { Kind = MetricKind.NetUp, Row = 1, Order = 0, ShowLabel = false },\n        new() { Kind = MetricKind.Cpu, Row = 1, Order = 1 },\n        new() { Kind = MetricKind.Ram, Row = 1, Order = 2, ShowPercent = false, ShowTemperature = false },\n        new() { Kind = MetricKind.NetDown, Row = 2, Order = 0, ShowLabel = false },\n        new() { Kind = MetricKind.Gpu, Row = 2, Order = 1 },\n        new() { Kind = MetricKind.Vram, Row = 2, Order = 2, ShowPercent = false, ShowTemperature = false },\n        new() { Kind = MetricKind.DiskActivity, Row = 2, Order = 3, Enabled = false },\n        new() { Kind = MetricKind.DiskSpace, Row = 2, Order = 4, Enabled = false, ShowPercent = false, ShowTemperature = false },\n        new() { Kind = MetricKind.Battery, Row = 2, Order = 5, Enabled = false, ShowPercent = true, ShowTemperature = false },\n    };\n\n    public void Normalize()\n    {\n        Blocks ??= DefaultBlocks();\n        // add any kinds missing (forward compat)\n        foreach (var kind in Enum.GetValues<MetricKind>())\n            if (Blocks.All(b => b.Kind != kind))\n                Blocks.Add(new BlockSettings { Kind = kind, Enabled = false });\n        var order = 0;\n        foreach (var b in Blocks.Where(b => b.Row == 1).OrderBy(b => b.Order)) b.Order = order++;\n        order = 0;\n        foreach (var b in Blocks.Where(b => b.Row == 2).OrderBy(b => b.Order)) b.Order = order++;\n        if (!Blocks.Any(b => b.Enabled)) Blocks[0].Enabled = true;\n        RefreshMs = Math.Clamp(RefreshMs, 250, 10000);\n        FontSize = Math.Clamp(FontSize, 8, 24);\n        Spacing = Math.Clamp(Spacing, 0, 40);\n        GapFromTray = Math.Clamp