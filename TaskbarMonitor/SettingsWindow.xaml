<Window x:Class="TaskbarMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar Monitor" Width="1000" Height="880" MinWidth="900" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#15171A" />
        <SolidColorBrush x:Key="Muted" Color="#71757E" />
        <SolidColorBrush x:Key="LineSoft" Color="#ECEEF2" />
        <SolidColorBrush x:Key="Accent" Color="#2D7FF9" />
        <SolidColorBrush x:Key="Chip" Color="#F0F2F6" />
        <SolidColorBrush x:Key="RowHighlight" Color="#F5F9FF" />
        <SolidColorBrush x:Key="Surface" Color="#F5F6F8" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#E6E8EC" />
        <SolidColorBrush x:Key="FieldBorder" Color="#DDE1E7" />
        <SolidColorBrush x:Key="SectionFg" Color="#8A8E98" />
        <SolidColorBrush x:Key="BadgeBg" Color="#E8F0FE" />
        <SolidColorBrush x:Key="BadgeInk" Color="#1F6FD0" />
        <SolidColorBrush x:Key="SwitchTrack" Color="#D6DAE1" />
        <SolidColorBrush x:Key="SliderTrack" Color="#E1E5EB" />
        <SolidColorBrush x:Key="HoverBg" Color="#F4F6F9" />
        <SolidColorBrush x:Key="PressedBg" Color="#E9EDF3" />

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SectionFg}" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>

        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource FieldBorder}"
                                    BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <ContentPresenter Margin="9,0,30,0" VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{DynamicResource Ink}" />
                                    <Path HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"
                                          Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="7" Margin="0,4,0,0">
                                    <ScrollViewer Margin="2">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHighlight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- iOS style switch, no animation on purpose -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource SwitchTrack}" />
                            <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" Background="White"
                                    HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9FA3AD" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="12,2" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Marker" Width="3" Height="16" CornerRadius="2"
                                        Background="Transparent" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#23252C" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#272A33" />
                                <Setter TargetName="Marker" Property="Background" Value="#2D7FF9" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource SliderTrack}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Accent}" Stroke="White" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1"
                                CornerRadius="7" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Accent}" CornerRadius="7" Padding="18,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E6FE8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A63D2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="#191A1F">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="20,22,16,24">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#2D7FF9">
                        <Path Data="M2,9 H4 V14 H2 Z M6,6 H8 V14 H6 Z M10,8 H12 V14 H10 Z M14,3 H16 V14 H14 Z"
                              Fill="White" Width="16" Height="16" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Taskbar Monitor" Foreground="#F4F5F7" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Settings" Foreground="#8A8D97" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavBlocks" Style="{StaticResource NavItem}" GroupName="Nav" AutomationProperties.Name="Widgets"
                                 IsChecked="True" Tag="Blocks" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M2,2 H7 V7 H2 Z M9,2 H14 V7 H9 Z M2,9 H7 V14 H2 Z M9,9 H14 V14 H9 Z" />
                            <TextBlock Text="Widgets" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" GroupName="Nav" AutomationProperties.Name="Appearance"
                                 Tag="Appearance" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M8,2 A6,6 0 1 1 7.99,2 Z M8,5.5 A2.5,2.5 0 1 1 7.99,5.5 Z" />
                            <TextBlock Text="Appearance" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavPosition" Style="{StaticResource NavItem}" GroupName="Nav" AutomationProperties.Name="Position"
                                 Tag="Position" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M7,2 H9 V7 H14 V9 H9 V14 H7 V9 H2 V7 H7 Z" />
                            <TextBlock Text="Position" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" GroupName="Nav" AutomationProperties.Name="Startup"
                                 Tag="Startup" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  Data="M8,2 V7 M4.4,3.9 A5,5 0 1 0 11.6,3.9" />
                            <TextBlock Text="Startup" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Settings save automatically" Foreground="#6E7079"
                           FontSize="11" Margin="20,0,16,20" />
            </Grid>
        </Border>

        <!-- ================= Content ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,24,28,14">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Widgets" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                    <TextBlock x:Name="PageSubtitle" Text="Choose which widgets appear on the taskbar."
                               Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource BadgeBg}" CornerRadius="10" Padding="10,4">
                    <TextBlock x:Name="ElevationBadge" Text="Standard user" Foreground="{DynamicResource BadgeInk}" FontSize="11.5" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="28,0,28,0">

                <!-- Blocks -->
                <ScrollViewer x:Name="BlocksPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="2,0,0,0">
                            <TextBlock Text="ON THE TASKBAR" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Right" Background="{DynamicResource BadgeBg}" CornerRadius="9" Padding="9,2">
                                <TextBlock x:Name="WidgetsCount" Text="0 of 6 on" FontSize="11" Foreground="{DynamicResource BadgeInk}" />
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel x:Name="BlocksPanel" />
                        </Border>
                        <TextBlock Text="Switch a widget on to show it; open it to change its label and options."
                                   Style="{StaticResource Caption}" Margin="2,8,0,16" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Appearance -->
                <ScrollViewer x:Name="AppearancePage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="THEME" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}" Margin="0,8,0,20">
                            <StackPanel>
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Theme" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Applies to this window only; the taskbar readings stay transparent."
                                                   Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="190" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="TYPOGRAPHY" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}" Margin="0,8,0,20">
                            <StackPanel>
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Font" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Used by the readings on the taskbar." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox x:Name="FontCombo" Grid.Column="1" Width="190" VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="16,0" />
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Size" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Text size of every reading." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="250">
                                        <Slider x:Name="SizeSlider" Width="180" Minimum="9" Maximum="20"
                                                TickFrequency="1" IsSnapToTickEnabled="True" />
                                        <TextBlock x:Name="SizeValue" Width="55" TextAlignment="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="16,0" />
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Spacing" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Space between the widgets." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="250">
                                        <Slider x:Name="SpacingSlider" Width="180" Minimum="2" Maximum="30"
                                                TickFrequency="1" IsSnapToTickEnabled="True" />
                                        <TextBlock x:Name="SpacingValue" Width="55" TextAlignment="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="NETWORK" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}" Margin="0,8,0,20">
                            <Grid Margin="16,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Unit" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Show network speed as bits or bytes." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="NetUnitCombo" Grid.Column="1" Width="190" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="READINGS" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}" Margin="0,8,0,20">
                            <StackPanel>
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Update every" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="How often the sensors are read, in milliseconds." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="250">
                                        <Slider x:Name="RefreshSlider" Width="180" Minimum="250" Maximum="10000"
                                                TickFrequency="50" IsSnapToTickEnabled="True" />
                                        <TextBox x:Name="RefreshValue" Width="55" Height="26" MinHeight="26" Margin="8,0,0,0"
                                                 TextAlignment="Right" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="WARNINGS" Style="{StaticResource SectionTitle}" />                        <Border Style="{StaticResource Card}" Margin="0,8,0,20">
                            <StackPanel>
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Amber above (%)" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="CPU, GPU, RAM and disk percentages turn amber." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="250">
                                        <Slider x:Name="PercentAmberSlider" Width="180" Minimum="50" Maximum="99"
                                                TickFrequency="1" IsSnapToTickEnabled="True" />
                                        <TextBox x:Name="PercentAmberValue" Width="55" Height="26" MinHeight="26" Margin="8,0,0,0"
                                                 TextAlignment="Right" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="16,0" />
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Red above (%)" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Percentages turn red above this level." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="250">
                                        <Slider x:Name="PercentRedSlider" Width="180" Minimum="60" Maximum="100"
                                                TickFrequency="1" IsSnapToTickEnabled="True" />
                                        <TextBox x:Name="PercentRedValue" Width="55" Height="26" MinHeight="26" Margin="8,0,0,0"
                                                 TextAlignment="Right" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="16,0" />
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Amber above (°C)" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="CPU and GPU temperatures turn amber." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="250">
                                        <Slider x:Name="TempAmberSlider" Width="180" Minimum="60" Maximum="109"
                                                TickFrequency="1" IsSnapToTickEnabled="True" />
                                        <TextBox x:Name="TempAmberValue" Width="55" Height="26" MinHeight="26" Margin="8,0,0,0"
                                                 TextAlignment="Right" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="16,0" />
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Red above (°C)" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Temperatures turn red above this level." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="250">
                                        <Slider x:Name="TempRedSlider" Width="180" Minimum="70" Maximum="115"
                                                TickFrequency="1" IsSnapToTickEnabled="True" />
                                        <TextBox x:Name="TempRedValue" Width="55" Height="26" MinHeight="26" Margin="8,0,0,0"
                                                 TextAlignment="Right" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ALERTS" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}" Margin="0,8,0,20">
                            <Grid Margin="16,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Critical alerts" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="A note above the taskbar with a sound when a value stays above its red level for a minute."
                                               Style="{StaticResource RowDesc}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox x:Name="AlertsCheck" Grid.Column="1" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Position -->
                <ScrollViewer x:Name="PositionPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="MONITOR" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}" Margin="0,8,0,20">
                            <StackPanel>
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Show on all taskbars" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Put a copy of the readings on every monitor."
                                                   Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="AllMonitorsCheck" Grid.Column="1" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="16,0" />
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Monitor" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Which taskbar the readings attach to." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox x:Name="MonitorCombo" Grid.Column="1" Width="300" VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="16,0" />
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Show over full-screen apps" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Keep the readings visible when a program covers the taskbar."
                                                   Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="FullscreenCheck" Grid.Column="1" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PLACEMENT" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Gap from tray" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Space between the block and the tray icons." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="250">
                                        <Slider x:Name="GapSlider" Width="180" Minimum="0" Maximum="80"
                                                TickFrequency="1" IsSnapToTickEnabled="True" />
                                        <TextBox x:Name="GapValue" Width="55" Height="26" MinHeight="26" Margin="8,0,0,0"
                                                 TextAlignment="Right" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="16,0" />
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Offset from right edge" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="How far the block sits from the right edge. 0 means just left of the tray icons."
                                                   Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="250">
                                        <Slider x:Name="RightOffsetSlider" Width="180" Minimum="0" Maximum="900"
                                                TickFrequency="10" IsSnapToTickEnabled="True" />
                                        <TextBox x:Name="RightOffsetValue" Width="55" Height="26" MinHeight="26" Margin="8,0,0,0"
                                                 TextAlignment="Right" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="16,0" />
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Vertical offset" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Nudge the block up or down inside the taskbar." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Width="250">
                                        <Slider x:Name="VerticalSlider" Width="180" Minimum="-30" Maximum="40"
                                                TickFrequency="1" IsSnapToTickEnabled="True" />
                                        <TextBox x:Name="VerticalValue" Width="55" Height="26" MinHeight="26" Margin="8,0,0,0"
                                                 TextAlignment="Right" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="16,0" />
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Reset placement" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Back to an 8 px gap with no offsets."
                                                   Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button x:Name="ResetPlacementButton" Grid.Column="1" Content="Reset"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                            Click="ResetPlacement_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Startup -->
                <ScrollViewer x:Name="StartupPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="WINDOWS STARTUP" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}" Margin="0,8,0,20">
                            <StackPanel>
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Launch the readings when you sign in." Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="StartWithWindowsCheck" Grid.Column="1" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="16,0" />
                                <Grid Margin="16,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Run as administrator at startup" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Needed for CPU temperature. Registered once as a scheduled task, so Windows does not ask at every login."
                                                   Style="{StaticResource RowDesc}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="StartElevatedCheck" Grid.Column="1" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource LineSoft}" Margin="16,0" />
                                <StackPanel Orientation="Horizontal" Margin="16,12">
                                    <Button Content="Restart as administrator" Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,0" Click="RestartAdmin_Click" />
                                    <Button Content="Open settings folder" Style="{StaticResource SecondaryButton}"
                                            Click="OpenFolder_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SENSOR STATUS" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel Margin="16,12">
                                <TextBlock x:Name="CpuStatusText" Style="{StaticResource RowDesc}" />
                                <Button x:Name="InstallPawnIoButton" Content="Install the PawnIO driver"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" Visibility="Collapsed" Click="InstallPawnIo_Click" />
                                <TextBlock x:Name="GpuStatusText" Style="{StaticResource RowDesc}" Margin="0,6,0,0" />
                                <TextBlock x:Name="StartupStatusText" Style="{StaticResource RowDesc}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Portable build: keep this folder together. Settings and the log live in %AppData%\TaskbarMonitor."
                                   Style="{StaticResource Caption}" Margin="2,12,0,16" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Live preview: mock taskbar that follows the real taskbar theme -->
            <Border x:Name="PreviewBar" Grid.Row="2" Background="#232329" CornerRadius="10"
                    Height="66" Margin="28,12,28,10" BorderThickness="1">
                <Viewbox x:Name="PreviewHost" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="52" Margin="18,0">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="PreviewMeterHost" VerticalAlignment="Center" />
                        <TextBlock x:Name="PreviewClock" Text="9:41 PM" FontSize="12"
                                   Margin="18,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Viewbox>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="3" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="28,12">
                <Grid>
                    <TextBlock x:Name="FooterText" Text="Changes apply instantly and are saved automatically."
                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Reset defaults" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Click="ResetDefaults_Click" />
                        <Button Content="Close" Style="{StaticResource PrimaryButton}" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>


